# Локальная БД: `pnpm db` (embedded Postgres) или `docker compose up -d`
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/peciatka
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/peciatka_test

# Публичный адрес фронта: ссылки в письмах, QR, Wallet.
# Для теста на телефоне подставьте https-адрес туннеля (cloudflared).
APP_URL=http://localhost:5174
APP_NAME=Pečiatka
PORT=3001

# Без ключа письма выводятся в консоль API.
RESEND_API_KEY=
MAIL_FROM="Pečiatka <noreply@example.com>"

# ── Apple Wallet (необязательно; без ключей кнопка скрыта) ──
# Локально можно положить файлы в certs/: signerCert.pem, signerKey.pem, wwdr.pem
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_SIGNER_CERT_B64=
APPLE_SIGNER_KEY_B64=
APPLE_SIGNER_KEY_PASSPHRASE=
APPLE_WWDR_CERT_B64=

# ── Google Wallet (необязательно) ── локально: certs/google-sa.json
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_KEY_B64=
