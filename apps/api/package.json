{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "db:start": "tsx scripts/dev-db.ts",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "start:prod": "prisma migrate deploy && node dist/server.js"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@fastify/cookie": "^11.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "@node-rs/argon2": "^2.0.0",
    "@peciatka/shared": "workspace:*",
    "@prisma/client": "^6.0.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "google-auth-library": "^11.1.0",
    "libphonenumber-js": "^1.13.14",
    "passkit-generator": "^3.6.1",
    "pdfkit": "^0.20.2",
    "prisma": "^6.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "dotenv": "^16.4.0",
    "dotenv-cli": "^8.0.0",
    "embedded-postgres": "18.4.0-beta.17",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
