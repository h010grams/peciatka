{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "db",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-c", "export PATH=\"$HOME/.local/node/bin:$PATH\"; pnpm db"],
      "port": 5434
    },
    {
      "name": "api",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-c", "export PATH=\"$HOME/.local/node/bin:$PATH\"; pnpm --filter api dev"],
      "port": 3001
    },
    {
      "name": "web",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-c", "export PATH=\"$HOME/.local/node/bin:$PATH\"; pnpm --filter web dev"],
      "port": 5174
    }
  ]
}
